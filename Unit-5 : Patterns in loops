1(h). Diamond Pattern
Program
n = int(input("Enter rows: "))

for i in range(1, n + 1):

    for j in range(n - i):
        print(" ", end=" ")

    for k in range(2 * i - 1):
        print("*", end=" ")

    print()

for i in range(n - 1, 0, -1):

    for j in range(n - i):
        print(" ", end=" ")

    for k in range(2 * i - 1):
        print("*", end=" ")

    print()
Input
Enter rows: 4
Output
      *
    * * *
  * * * * *
* * * * * * *
  * * * * *
    * * *
      *


